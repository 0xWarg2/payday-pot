{
  "name": "@payday-pot/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "copy-sdk": "node scripts/copy-relayer-sdk.mjs",
